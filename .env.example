PORT=5000
# If password has special chars (@ : / # ? etc), URL-encode them.
# Example: password subham@123 → subham%40123
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/bookreader?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
OCR_PROVIDER=tesseract
MAX_FILE_SIZE_MB=15

# Bootstrap admin (created/updated on server start)
ADMIN_EMAIL=subhamkumarsahoo9090@gmail.com
ADMIN_PASSWORD=123456
# Comma-separated emails promoted to admin on login
ADMIN_EMAILS=subhamkumarsahoo9090@gmail.com

# Google OAuth + Drive (optional — feature-flagged if missing)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
