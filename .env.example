PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/bookreader
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# OCR: "tesseract" (default, free/local) or "google"
OCR_PROVIDER=tesseract

# Required only when OCR_PROVIDER=google
# Path to Google Cloud Vision service account JSON
GOOGLE_APPLICATION_CREDENTIALS=

# Upload limits
MAX_FILE_SIZE_MB=15
